FROM node:22-alpine

WORKDIR /app

# Install deps based on lockfile only — fast, reproducible, cached.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Prisma schema needs to be present for `prisma generate`.
COPY prisma ./prisma
RUN npx prisma generate

# Source is mounted as a volume in compose; copy as a fallback for `docker run`.
COPY . .

EXPOSE 3000

# `db push` initializes the schema on every boot (idempotent),
# then seeds the demo org/brand/user/request, then starts dev.
CMD ["sh", "-c", "npx prisma db push --skip-generate && npm run db:seed && npm run dev -- -H 0.0.0.0"]
